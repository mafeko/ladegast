# Kopieren nach .env und mit echten Werten befuellen.
# .env wird nie committed (siehe .gitignore).
# Vollstaendige Referenz: schema/config.md

LADEGAST_LISTEN_ADDR=:8080
LADEGAST_PUBLIC_BASE_URL=https://example.com
LADEGAST_PUBLIC_PATH_PREFIX=/public
LADEGAST_ADMIN_PATH_PREFIX=/admin
LADEGAST_DATA_DIR=./data

# Pflicht, kein Default:
LADEGAST_SESSION_SECRET=change-me-to-a-random-secret
LADEGAST_EVCC_BASE_URL=https://evcc.example.com
LADEGAST_EVCC_API_KEY=evcc_changeme

# Nur beim allerersten Start benoetigt (legt den Admin-Account an):
LADEGAST_ADMIN_USERNAME=admin
LADEGAST_ADMIN_PASSWORD=change-me

LADEGAST_RATE_LIMIT_MAX_ATTEMPTS=5
LADEGAST_RATE_LIMIT_WINDOW=15m
